\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Data-derived paired forest of the tested $n{=}400$ reference-budget curve: the same four contrasts, frozen records, and intervals as Table~\ref {tab:gt-result}, with no new decoding. Square area scales with the discordant count $m$; filled squares mark question-bootstrap intervals and open squares registered paired-SE intervals. The matched-$L$ primary endpoint and the decisive total-NFE-fair $2L$ equalization coincide at $+13.0\,\mathrm  {pp}$, while the reference improves with budget, contracting the gap to the conservative $+9.0\,\mathrm  {pp}$ read. All four intervals exclude zero. The dotted $4\,\mathrm  {pp}$ line is the registered \emph  {point-estimate} promotion bar, not a lower-bound requirement, so the high-budget interval reaching $3.46\,\mathrm  {pp}$ is expected (\S  \ref {sec:setup}). Regenerated by \path {paper/src/figures/decisive_paired_forest_refine10.py}.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:decisive-paired}{{2}{5}{Data-derived paired forest of the tested $n{=}400$ reference-budget curve: the same four contrasts, frozen records, and intervals as Table~\ref {tab:gt-result}, with no new decoding. Square area scales with the discordant count $m$; filled squares mark question-bootstrap intervals and open squares registered paired-SE intervals. The matched-$L$ primary endpoint and the decisive total-NFE-fair $2L$ equalization coincide at $+13.0\pp $, while the reference improves with budget, contracting the gap to the conservative $+9.0\pp $ read. All four intervals exclude zero. The dotted $4\pp $ line is the registered \emph {point-estimate} promotion bar, not a lower-bound requirement, so the high-budget interval reaching $3.46\pp $ is expected (\S \ref {sec:setup}). Regenerated by \protect \path {paper/src/figures/decisive_paired_forest_refine10.py}}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Same-bed per-token negative log-likelihood (nats; lower is better; $n{=}400$). $\rho $ relates true-option nats to correctness. For \texttt  {fixed\_inject}{}/\texttt  {s\_conf}{}, paired true-option directions are $349/40$ with 11 ties ($n_{\rm  selected}{=}389$, exact two-sided $p=1.1\!\times \!10^{-62}$). \texttt  {mc\_uniform}{} is the separate mask-out family.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:samebed-likelihood}{{2}{5}{Same-bed per-token negative log-likelihood (nats; lower is better; $n{=}400$). $\rho $ relates true-option nats to correctness. For \finj {}/\sconf {}, paired true-option directions are $349/40$ with 11 ties ($n_{\rm selected}{=}389$, exact two-sided $p=1.1\!\times \!10^{-62}$). \mcu {} is the separate mask-out family}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Tested reference-budget curve in ascending reference budget (reference/\texttt  {s\_conf}{} total NFE in parentheses; row labels are the per-candidate budget labels of Appendix Table~\ref {tab:compute-ledger}). The decisive row is total-NFE-fair equalization at $2L$, where the reference uses $n_{{\rm  mc},i}=2L_i$ forwards and \texttt  {s\_conf}{} $L_i$ scoring plus $L_i$ schedule-selection forwards. The pre-registered nominal matched-$L$ point (reference $n_{{\rm  mc},i}=L_i$, nominal draw-count match only, primary endpoint per registration) is measured on the same $n{=}400$ items as that decisive row, with the same \texttt  {s\_conf}{} trajectories ($171/400$) and the same $+13.0\,\mathrm  {pp}$ headline, so the two endpoints are numerically distinct paired records with interchangeable headline readings.\footnotemark {} The two $n_{{\rm  mc},i}$ rows quote question-bootstrap intervals (20k, seed 20260824) and the rest the registered paired SE $\sqrt  {m}/n$; tests are exact two-sided McNemar; Figure~\ref {fig:decisive-paired} plots the four $n{=}400$ rows. The $n{=}64$ scan is exploratory and superseded.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:gt-result}{{3}{6}{Tested reference-budget curve in ascending reference budget (reference/\sconf {} total NFE in parentheses; row labels are the per-candidate budget labels of Appendix Table~\ref {tab:compute-ledger}). The decisive row is total-NFE-fair equalization at $2L$, where the reference uses $n_{{\rm mc},i}=2L_i$ forwards and \sconf {} $L_i$ scoring plus $L_i$ schedule-selection forwards. The pre-registered nominal matched-$L$ point (reference $n_{{\rm mc},i}=L_i$, nominal draw-count match only, primary endpoint per registration) is measured on the same $n{=}400$ items as that decisive row, with the same \sconf {} trajectories ($171/400$) and the same $+13.0\pp $ headline, so the two endpoints are numerically distinct paired records with interchangeable headline readings.\protect \footnotemark {} The two $n_{{\rm mc},i}$ rows quote question-bootstrap intervals (20k, seed 20260824) and the rest the registered paired SE $\sqrt {m}/n$; tests are exact two-sided McNemar; Figure~\ref {fig:decisive-paired} plots the four $n{=}400$ rows. The $n{=}64$ scan is exploratory and superseded}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Reference-arm calibration against the chance level of each declared four-choice pool (exact one-sided binomial tests on the arm's own correct count). Rows 2--4 are the same $n=400$ pool at three scoring budgets; the last row is a historical pilot on a different pool, not a large-pool substitute. These five tests are the paper's one uncorrected family, so the last column scores each against the Bonferroni--5 bar $\alpha =0.05/5=0.01$: three rows clear it and the two lowest-budget $n{=}400$ reads do not. The per-candidate draw-matched row sets $n_{{\rm  mc},i}{=}L_i$ per candidate. Those two remain corroborative chance checks either way; no headline claim rests on this family, because the headline claims are the paired McNemar contrasts of Table~\ref {tab:gt-result}, which are unchanged by any correction applied here.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:reference-calibration}{{4}{6}{Reference-arm calibration against the chance level of each declared four-choice pool (exact one-sided binomial tests on the arm's own correct count). Rows 2--4 are the same $n=400$ pool at three scoring budgets; the last row is a historical pilot on a different pool, not a large-pool substitute. These five tests are the paper's one uncorrected family, so the last column scores each against the Bonferroni--5 bar $\alpha =0.05/5=0.01$: three rows clear it and the two lowest-budget $n{=}400$ reads do not. The per-candidate draw-matched row sets $n_{{\rm mc},i}{=}L_i$ per candidate. Those two remain corroborative chance checks either way; no headline claim rests on this family, because the headline claims are the paired McNemar contrasts of Table~\ref {tab:gt-result}, which are unchanged by any correction applied here}{table.4}{}}
