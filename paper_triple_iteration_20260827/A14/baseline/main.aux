\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Analysis map: headline estimands of this paper. \emph  {Pool} = question bed; \emph  {Prereg.\ status} = whether the endpoint was fixed before observing data; \emph  {Direction} = pre-registered read direction ($+$ = first-listed arm better, $-$ = second-listed arm better, $0$ = symmetric/diagnostic); \emph  {Family} = multiplicity correction under which the displayed $p$ is read; \emph  {Primary interval} = the registered or displayed uncertainty convention; \emph  {Verdict} = the registered or post-hoc reading (Holm survive / Bonf.\ clear / CI or LB excludes $0$ or fails to). Discounted secondary diagnostics (chance calibration, strata) follow the same per-row convention.}}{7}{table.5}\protected@file@percent }
\newlabel{tab:analysis-map}{{5}{7}{Analysis map: headline estimands of this paper. \emph {Pool} = question bed; \emph {Prereg.\ status} = whether the endpoint was fixed before observing data; \emph {Direction} = pre-registered read direction ($+$ = first-listed arm better, $-$ = second-listed arm better, $0$ = symmetric/diagnostic); \emph {Family} = multiplicity correction under which the displayed $p$ is read; \emph {Primary interval} = the registered or displayed uncertainty convention; \emph {Verdict} = the registered or post-hoc reading (Holm survive / Bonf.\ clear / CI or LB excludes $0$ or fails to). Discounted secondary diagnostics (chance calibration, strata) follow the same per-row convention}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Data-derived per-question Kendall $\tau $ distributions for \texttt  {s\_conf}{} versus \texttt  {rand\_inject}{}. Points are deterministic question-level values; boxes show quartiles and the center line shows the median. The mean printed below each box is the locked overlay value rounded to three decimals (Table~\ref {tab:rank-diagnostics} gives four). The comparison floor is the random arm's own self-$\tau $ (mean $0.2361$, Table~\ref {tab:rank-diagnostics}); the cross-protocol means sit only $0.01$--$0.10$ above it, i.e.\ within the floor's dispersion, so this panel is descriptive, not inferential.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:tau}{{3}{7}{Data-derived per-question Kendall $\tau $ distributions for \sconf {} versus \rinj {}. Points are deterministic question-level values; boxes show quartiles and the center line shows the median. The mean printed below each box is the locked overlay value rounded to three decimals (Table~\ref {tab:rank-diagnostics} gives four). The comparison floor is the random arm's own self-$\tau $ (mean $0.2361$, Table~\ref {tab:rank-diagnostics}); the cross-protocol means sit only $0.01$--$0.10$ above it, i.e.\ within the floor's dispersion, so this panel is descriptive, not inferential}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Reveal-order evidence and attribution control. Fresh is secondary, pilot undetermined, and pooled a heterogeneous-pool disclosure; their magnitudes differ ($z{=}2.41$, $p{=}0.016$; robust $z{=}2.32$). The fixed control bounds \texttt  {s\_conf}{}'s advantage at $+2.32\,\mathrm  {pp}$ (95\% CI upper), and only 2.1\% of order traces match. Cells mark one-sided (1s, constant $2.4865$) or two-sided (2s, $2.8016$) intervals/MDE$_{80}$, each as registered per endpoint (the fresh endpoint's registered rule is one-sided); Appendix Figure~\ref {fig:forest-app} uses the paired-bootstrap two-sided CI for the fresh row as a display convention. Raw exact two-sided McNemar $p$ per row: fresh $204/101$, $p{=}3.7\!\times \!10^{-9}$; fresh-fixed $99/145$, $p{=}0.0039$; fixed control $p{=}0.334$ (pilot/pooled as per their registered rules). All use paired SE $\sqrt  {m}/n$. The fresh row collapses the two construction strata that Appendix Table~\ref {tab:fresh-strata-app} reports separately.}}{8}{table.6}\protected@file@percent }
\newlabel{tab:reveal-order-batches}{{6}{8}{Reveal-order evidence and attribution control. Fresh is secondary, pilot undetermined, and pooled a heterogeneous-pool disclosure; their magnitudes differ ($z{=}2.41$, $p{=}0.016$; robust $z{=}2.32$). The fixed control bounds \sconf {}'s advantage at $+2.32\pp $ (95\% CI upper), and only 2.1\% of order traces match. Cells mark one-sided (1s, constant $2.4865$) or two-sided (2s, $2.8016$) intervals/MDE$_{80}$, each as registered per endpoint (the fresh endpoint's registered rule is one-sided); Appendix Figure~\ref {fig:forest-app} uses the paired-bootstrap two-sided CI for the fresh row as a display convention. Raw exact two-sided McNemar $p$ per row: fresh $204/101$, $p{=}3.7\!\times \!10^{-9}$; fresh-fixed $99/145$, $p{=}0.0039$; fixed control $p{=}0.334$ (pilot/pooled as per their registered rules). All use paired SE $\sqrt {m}/n$. The fresh row collapses the two construction strata that Appendix Table~\ref {tab:fresh-strata-app} reports separately}{table.6}{}}
