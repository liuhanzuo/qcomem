\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Fresh-pool strata split on the enlarged $n{=}819$ bed; $b/c$ and $p$ are paired discordants and exact two-sided McNemar. The three positive estimates are distinct estimands rather than replications: fresh \texttt  {s\_conf}{}-vs-\texttt  {rand\_inject}{} $+12.58\,\mathrm  {pp}$ ($n{=}819$), paired-bed \texttt  {s\_conf}{}-vs-\texttt  {mc\_uniform}{} $+13.0\,\mathrm  {pp}$ ($n{=}400$ at both $L/2L$ and $2L/2L$), and heterogeneous pooled \texttt  {s\_conf}{}-vs-\texttt  {rand\_inject}{} $+9.68\,\mathrm  {pp}$ ($n{=}1219$). The position audit is post-hoc and uses the Bonferroni--4 control stated in the main text.}}{12}{table.8}\protected@file@percent }
\newlabel{tab:fresh-strata-app}{{8}{12}{Fresh-pool strata split on the enlarged $n{=}819$ bed; $b/c$ and $p$ are paired discordants and exact two-sided McNemar. The three positive estimates are distinct estimands rather than replications: fresh \sconf {}-vs-\rinj {} $+12.58\pp $ ($n{=}819$), paired-bed \sconf {}-vs-\mcu {} $+13.0\pp $ ($n{=}400$ at both $L/2L$ and $2L/2L$), and heterogeneous pooled \sconf {}-vs-\rinj {} $+9.68\pp $ ($n{=}1219$). The position audit is post-hoc and uses the Bonferroni--4 control stated in the main text}{table.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Three pool contrasts from Table~\ref {tab:reveal-order-batches}. Fresh uses a paired-bootstrap 95\% CI, pilot the registered-SE two-sided CI, and pooled a one-sided lower bound (open upper cap is display-only). Square area scales with $m$; significant heterogeneity makes pooled secondary.}}{12}{figure.4}\protected@file@percent }
\newlabel{fig:forest-app}{{4}{12}{Three pool contrasts from Table~\ref {tab:reveal-order-batches}. Fresh uses a paired-bootstrap 95\% CI, pilot the registered-SE two-sided CI, and pooled a one-sided lower bound (open upper cap is display-only). Square area scales with $m$; significant heterogeneity makes pooled secondary}{figure.4}{}}
\citation{efron1994bootstrap}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces All six injected-order contrasts on the $n=400$ pool. Exact tests are two-sided and Holm-adjusted within this registered family of six (the six pairwise order contrasts are the declared secondary family; the confirmatory $n{=}400$ budget-curve family of \emph  {\S  \ref {sec:result1}} is the separate ten-test Holm family). Each interval is $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \Delta $}\mathaccent "0362{\Delta }\pm h$. The last two columns give the two paired-SE conventions: the manuscript quotes the registered $h=1.96\sqrt  {m}/n$ throughout, and the mean-corrected $h=1.96\sqrt  {m-(b-c)^2/n}/n$ differs from it by at most $0.04\,\mathrm  {pp}$ here (and by at most $1.2\,\mathrm  {pp}$ on the small $n=48/64$ pools, where no verdict changes either). Holm adjustment is step-down with monotonicity enforced, so adjusted $p$ is non-decreasing in raw $p$; in particular the largest raw $p$ in the family inherits Holm $p=1.000$.}}{13}{table.9}\protected@file@percent }
\newlabel{tab:order-six-ci}{{9}{13}{All six injected-order contrasts on the $n=400$ pool. Exact tests are two-sided and Holm-adjusted within this registered family of six (the six pairwise order contrasts are the declared secondary family; the confirmatory $n{=}400$ budget-curve family of \emph {\S \ref {sec:result1}} is the separate ten-test Holm family). Each interval is $\widehat \Delta \pm h$. The last two columns give the two paired-SE conventions: the manuscript quotes the registered $h=1.96\sqrt {m}/n$ throughout, and the mean-corrected $h=1.96\sqrt {m-(b-c)^2/n}/n$ differs from it by at most $0.04\pp $ here (and by at most $1.2\pp $ on the small $n=48/64$ pools, where no verdict changes either). Holm adjustment is step-down with monotonicity enforced, so adjusted $p$ is non-decreasing in raw $p$; in particular the largest raw $p$ in the family inherits Holm $p=1.000$}{table.9}{}}
