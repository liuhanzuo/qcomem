\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}A tested spectral residual family does not trigger on L16}{7}{subsection.3.3}\protected@file@percent }
\newlabel{sec:nonnest}{{3.3}{7}{A tested spectral residual family does not trigger on L16}{subsection.3.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Spectral (DFT) periodogram of the adjacent-difference profile $d(r)$ --- an \emph  {exploratory}, non-nesting check (Section~\ref {sec:nonnest}). $G(P)$ is the normalized spectral magnitude at frequency $1/P$; ``fires'' means the $32$-component exceeds its permutation $q_{95}$ ($4{,}000$ replicates). The upper panel completes the synthetic diagnostic grid and reports every real candidate; the lower panel separates the supporting power, harmonic, and two-sample checks from their interpretation. The synthetic residual fires, whereas the comb-only synthetic and real L16 profile are null at the target period. On real L16, no candidate in the tested grid is significant; only the recorder-comb harmonics fire. The power sweep brackets sensitivity for the tested sinusoidal family only, and the direct boundary-subset comparison finds no split. Provenance is in Table~\ref {tab:artifacts}.}}{7}{table.7}\protected@file@percent }
\newlabel{tab:spectral}{{7}{7}{Spectral (DFT) periodogram of the adjacent-difference profile $d(r)$ --- an \emph {exploratory}, non-nesting check (Section~\ref {sec:nonnest}). $G(P)$ is the normalized spectral magnitude at frequency $1/P$; ``fires'' means the $32$-component exceeds its permutation $q_{95}$ ($4{,}000$ replicates). The upper panel completes the synthetic diagnostic grid and reports every real candidate; the lower panel separates the supporting power, harmonic, and two-sample checks from their interpretation. The synthetic residual fires, whereas the comb-only synthetic and real L16 profile are null at the target period. On real L16, no candidate in the tested grid is significant; only the recorder-comb harmonics fire. The power sweep brackets sensitivity for the tested sinusoidal family only, and the direct boundary-subset comparison finds no split. Provenance is in Table~\ref {tab:artifacts}}{table.7}{}}
