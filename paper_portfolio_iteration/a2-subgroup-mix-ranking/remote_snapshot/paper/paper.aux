\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {M3 committed-rate at $\tau {=}0.04$, $\delta {=}0.1$, 3-seed means.} Coverage is $1.0$ on every committed row (0 violations over $4200$ cells). Uniform beats the allocation rules on MNIST (even reveal tightens every group's UCB, whereas concentration starves the group binding the $\qopname  \relax m{max}_j\DOTSB \sum@ \slimits@ _g w_g\mathrm  {UCB}$); the benefit is carrier-heterogeneous. The adaptive (CS) track commits $0$ everywhere (its always-valid width $\sim 0.06$--$0.14$ never falls under $\tau $). digits/news never commit (bandwidth wall), a coverage--tightness tradeoff, not a soundness failure.}}{6}{table.3}\protected@file@percent }
\newlabel{tab:m3}{{3}{6}{\textbf {M3 committed-rate at $\tau {=}0.04$, $\delta {=}0.1$, 3-seed means.} Coverage is $1.0$ on every committed row (0 violations over $4200$ cells). Uniform beats the allocation rules on MNIST (even reveal tightens every group's UCB, whereas concentration starves the group binding the $\max _j\sum _g w_g\mathrm {UCB}$); the benefit is carrier-heterogeneous. The adaptive (CS) track commits $0$ everywhere (its always-valid width $\sim 0.06$--$0.14$ never falls under $\tau $). digits/news never commit (bandwidth wall), a coverage--tightness tradeoff, not a soundness failure}{table.3}{}}
