{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "A11-WOR-CS-COMPARISON-OMR-R1-output",
  "title": "A11 same-endpoint comparator formal output contract",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "status",
    "provenance",
    "split_counts",
    "calibration",
    "test_readout",
    "primary_comparison",
    "integrity_checks",
    "interpretation_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment_id": {"const": "A11-WOR-CS-COMPARISON-OMR-R1"},
    "status": {"enum": ["complete_integrity_valid", "invalid_infrastructure_or_integrity"]},
    "provenance": {"type": "object"},
    "split_counts": {
      "type": "object",
      "required": ["FIT", "CAL", "TEST"]
    },
    "calibration": {"type": "object"},
    "test_readout": {"type": "object"},
    "primary_comparison": {"type": "object"},
    "integrity_checks": {"type": "object"},
    "interpretation_boundary": {"type": "array"}
  },
  "additionalProperties": false
}
