\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces TEST readout ($n=3607$ problems, $N=32$; $8$ rule--level rows under the Bonferroni CI of Section~\ref {sec:protocol} plus FULL-$32$ as the zero-count-reduction reference). Replay count reduction $=1-\bar  k/32$. BAYES-H attains the largest valid replay count reduction at $\alpha =0.05$ and $0.02$; at $\alpha =0.10$ FIXED-EB has $84.4\%$ replay count reduction versus BAYES-H $84.0\%$ (a $0.4$-point gap in mean replay count on this test pool, descriptive, no paired CI computed for this pair), while BAYES-H keeps the lowest realized flip at every level. WINDOW3 has the largest replay count reduction but is invalid at $\alpha \le 0.05$.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:main}{{1}{7}{TEST readout ($n=3607$ problems, $N=32$; $8$ rule--level rows under the Bonferroni CI of Section~\ref {sec:protocol} plus FULL-$32$ as the zero-count-reduction reference). Replay count reduction $=1-\bar k/32$. BAYES-H attains the largest valid replay count reduction at $\alpha =0.05$ and $0.02$; at $\alpha =0.10$ FIXED-EB has $84.4\%$ replay count reduction versus BAYES-H $84.0\%$ (a $0.4$-point gap in mean replay count on this test pool, descriptive, no paired CI computed for this pair), while BAYES-H keeps the lowest realized flip at every level. WINDOW3 has the largest replay count reduction but is invalid at $\alpha \le 0.05$}{table.1}{}}
