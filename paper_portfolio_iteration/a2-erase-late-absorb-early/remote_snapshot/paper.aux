\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Two-way budget switch (pilot 15, 6 seeds, medians). Raising GD budget flips first-cause$\to $recency; cutting SGD budget flips recency$\to $first-cause with the noise structure unchanged; equal-budget arms coincide across optimizers (ratio $0.82$). Geometric and functional crossing are synchronized (no accuracy-threshold artifact).}}{6}{table.1}\protected@file@percent }
\newlabel{tab:budget}{{1}{6}{Two-way budget switch (pilot 15, 6 seeds, medians). Raising GD budget flips first-cause$\to $recency; cutting SGD budget flips recency$\to $first-cause with the noise structure unchanged; equal-budget arms coincide across optimizers (ratio $0.82$). Geometric and functional crossing are synchronized (no accuracy-threshold artifact)}{table.1}{}}
