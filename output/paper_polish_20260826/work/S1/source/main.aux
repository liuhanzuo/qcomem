\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Unified LLaMA-2-7B evaluation at exact $2{:}4$ sparsity. Task cells are local plain-accuracy percentages; PPL is WikiText-2. Wanda, SparseGPT, ALPS, and ELSA are three-seed means. Recovery rows are not native checkpoints. The $625$M \textsc  {SparseForge}{} fixed-support matched-budget arm\footnotemark [1] and the recovery token budget and corpus of the public AST checkpoint are registered gaps; the AST row is a quality anchor with under-reported recovery-budget provenance, not a matched-budget control. This aggregate supports the archived AST comparison; Appendix~\ref {app:dispersion}, Table~\ref {tab:dispersion} reports baseline dispersion. Task abbreviations: BQ = BoolQ, Hella. = HellaSwag, Wino. = WinoGrande, ARC-e/c = ARC-Easy/Challenge, OBQA = OpenBookQA. The \textsc  {SparseForge}{} row is a branch-active training-state checkpoint (SLoRB live at inference); a folded exact-$2{:}4$ export has never been produced or measured (Appendix~\ref {app:implementation}, EXT-M3). The \textsc  {SparseForge}{} row is additionally a $5$B-token recovery checkpoint whose training-corpus provenance is unavailable (archived with the checkpoint; Appendix~\ref {app:implementation}); only the pending matched-budget arms use a locally tokenized Dolmino-mix-1124 stream.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:unified}{{1}{5}{Unified LLaMA-2-7B evaluation at exact $2{:}4$ sparsity. Task cells are local plain-accuracy percentages; PPL is WikiText-2. Wanda, SparseGPT, ALPS, and ELSA are three-seed means. Recovery rows are not native checkpoints. The $625$M \method {} fixed-support matched-budget arm\protect \footnotemark [1] and the recovery token budget and corpus of the public AST checkpoint are registered gaps; the AST row is a quality anchor with under-reported recovery-budget provenance, not a matched-budget control. This aggregate supports the archived AST comparison; Appendix~\ref {app:dispersion}, Table~\ref {tab:dispersion} reports baseline dispersion. Task abbreviations: BQ = BoolQ, Hella. = HellaSwag, Wino. = WinoGrande, ARC-e/c = ARC-Easy/Challenge, OBQA = OpenBookQA. The \method {} row is a branch-active training-state checkpoint (SLoRB live at inference); a folded exact-$2{:}4$ export has never been produced or measured (Appendix~\ref {app:implementation}, EXT-M3). The \method {} row is additionally a $5$B-token recovery checkpoint whose training-corpus provenance is unavailable (archived with the checkpoint; Appendix~\ref {app:implementation}); only the pending matched-budget arms use a locally tokenized Dolmino-mix-1124 stream}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Recovery Compression as the Load-Bearing Result}{5}{subsection.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Per-task accuracy difference \textsc  {SparseForge}{}-5B minus the public AST deployable checkpoint under the same nine-task harness, computed from the harness CSV. The Avg-9 difference is $+0.53$ points (dashed line), but task-level behavior is strongly mixed: BoolQ, ARC-Easy, ARC-Challenge, OpenBookQA, and RACE contribute the gain, while RTE moves by $-15.52$ points. The aggregate advantage over the strongest $625$M fixed-support recovery endpoint is $+2.53$ points.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:checkpoint}{{2}{6}{Per-task accuracy difference \method {}-5B minus the public AST deployable checkpoint under the same nine-task harness, computed from the harness CSV. The Avg-9 difference is $+0.53$ points (dashed line), but task-level behavior is strongly mixed: BoolQ, ARC-Easy, ARC-Challenge, OpenBookQA, and RACE contribute the gain, while RTE moves by $-15.52$ points. The aggregate advantage over the strongest $625$M fixed-support recovery endpoint is $+2.53$ points}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces RTE provenance and denominator checks for the 5B checkpoint. The earlier $69.82$ log is not representable as an integer correct count over 277 examples; the registered $49.82=138/277$ is used throughout. The $+0.528$-point Avg-9 margin remains sensitive to a small task-level change.}}{6}{table.2}\protected@file@percent }
