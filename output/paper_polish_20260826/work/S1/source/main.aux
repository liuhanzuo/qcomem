\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Registered recovery trajectory of the fixed ELSA support on the $5$B-token \textsc  {SparseForge}{} recovery stream: PPL drops from $8.99$ (step $0$) to a minimum of $7.15$ (step $100$), destabilizes step $300 \to 500$, and diverges past step $1000$ ($2930$ at step $500$, $4083$ at step $4600$). Raw per-step values are included in the anonymous artifact.}}{12}{figure.3}\protected@file@percent }
