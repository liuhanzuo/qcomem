\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces \textbf  {The matched read-depth direction survives both generation caps and all three readout conventions.} The mnt160/mnt512 roots reuse the same 100 samples at caps 160/512, not independent datasets; for missing-excluded rows accuracy is over the retained pairs answered under both protocols (independent $n=59/80$). The zero-free-parameter pinned rows are the primary magnitude and are the two rows promoted to the canonical main-text view (Table~\ref {tab:readdepth-main}): their exact paired 95\% CIs on the risk difference are $[+17.7,+30.5]$\,pp (mnt160) and $[+14.1,+28.7]$\,pp (mnt512), both excluding zero. The $[16.2,35.0]$~pp range is only the conditional min/max over the six cells; both endpoints use the stripped reader, so a wider strip rule can reverse the sign, and the pinned rows do \emph  {not} inherit it. A separate answer-anchored mnt512 reader gives a null cell ($p{=}0.0649$, conditional CI crossing zero) and is not folded into this six-cell range. Stripped digits use canonical \texttt  {split\_choices\_echo}, not an independent rescoring. All six cells sit on the content-hash-verified paired subset (Appendix~\ref {app:pairing-provenance}). The interval construction and its cross-checks are in Appendix~\ref {app:paired-cis}; Table~\ref {tab:invariance-diagnostics} reports headroom and parser diagnostics.}}{20}{table.8}\protected@file@percent }
\newlabel{tab:readdepth-decisive}{{8}{20}{\textbf {The matched read-depth direction survives both generation caps and all three readout conventions.} The mnt160/mnt512 roots reuse the same 100 samples at caps 160/512, not independent datasets; for missing-excluded rows accuracy is over the retained pairs answered under both protocols (independent $n=59/80$). The zero-free-parameter pinned rows are the primary magnitude and are the two rows promoted to the canonical main-text view (Table~\ref {tab:readdepth-main}): their exact paired 95\% CIs on the risk difference are $[+17.7,+30.5]$\,pp (mnt160) and $[+14.1,+28.7]$\,pp (mnt512), both excluding zero. The $[16.2,35.0]$~pp range is only the conditional min/max over the six cells; both endpoints use the stripped reader, so a wider strip rule can reverse the sign, and the pinned rows do \emph {not} inherit it. A separate answer-anchored mnt512 reader gives a null cell ($p{=}0.0649$, conditional CI crossing zero) and is not folded into this six-cell range. Stripped digits use canonical \texttt {split\_choices\_echo}, not an independent rescoring. All six cells sit on the content-hash-verified paired subset (Appendix~\ref {app:pairing-provenance}). The interval construction and its cross-checks are in Appendix~\ref {app:paired-cis}; Table~\ref {tab:invariance-diagnostics} reports headroom and parser diagnostics}{table.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Composition probe.}{20}{section*.41}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces \textbf  {BABILong qa2 composition and cap-sensitivity probes.} Panel (a) is scored with the same registered parser family as the qa1 decisive table (reader and data root are consolidated in the protocol matrix, Table \ref {tab:protocol-matrix}). The registered overall verdict here is \emph  {not evaluable}: both 4k and 8k separate, but the floor gate fails in a load bucket ($j{=}12$ at 8k is $23{<}k^*{=}24$). The probe therefore does not support a length-robust read-depth claim and is not load-bearing. The \emph  {re-forward} column is the authors' full-depth $j{=}0$ control without retrieval, not an implementation of a published method; no full-context arm was run on qa2. Panel (b) keeps the three registered legacy cap runs separate. At cap 160 the exact paired result is $p=0.00154$, with disjoint 95\% arm intervals $[6.3,18.6]$\% and $[19.3,36.4]$\%.}}{21}{table.9}\protected@file@percent }
\newlabel{tab:composition-app}{{9}{21}{\textbf {BABILong qa2 composition and cap-sensitivity probes.} Panel (a) is scored with the same registered parser family as the qa1 decisive table (reader and data root are consolidated in the protocol matrix, Table \ref {tab:protocol-matrix}). The registered overall verdict here is \emph {not evaluable}: both 4k and 8k separate, but the floor gate fails in a load bucket ($j{=}12$ at 8k is $23{<}k^*{=}24$). The probe therefore does not support a length-robust read-depth claim and is not load-bearing. The \emph {re-forward} column is the authors' full-depth $j{=}0$ control without retrieval, not an implementation of a published method; no full-context arm was run on qa2. Panel (b) keeps the three registered legacy cap runs separate. At cap 160 the exact paired result is $p=0.00154$, with disjoint 95\% arm intervals $[6.3,18.6]$\% and $[19.3,36.4]$\%}{table.9}{}}
