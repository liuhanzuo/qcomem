\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces \textbf  {Protocol matrix keeps generation caps and estimands separate.} Panel (a) records run identity and sample accounting; panel (b) separates reader/metric definitions from selectors; panel (c) consolidates the stable artifact and hash identifiers (the registered data roots, decision verdicts, CI input, preregistration pins, and reader-label implementations), which are referenced by name elsewhere instead of as mutable local paths. The mnt160 and mnt512 rows reuse the same qa1 samples at two caps, whereas the three qa2 cap rows are distinct executions. RULER fractional recall and strict full-match labels are likewise not merged into one \mbox  {decision} cell.}}{24}{table.12}\protected@file@percent }
\newlabel{tab:protocol-matrix}{{12}{24}{\textbf {Protocol matrix keeps generation caps and estimands separate.} Panel (a) records run identity and sample accounting; panel (b) separates reader/metric definitions from selectors; panel (c) consolidates the stable artifact and hash identifiers (the registered data roots, decision verdicts, CI input, preregistration pins, and reader-label implementations), which are referenced by name elsewhere instead of as mutable local paths. The mnt160 and mnt512 rows reuse the same qa1 samples at two caps, whereas the three qa2 cap rows are distinct executions. RULER fractional recall and strict full-match labels are likewise not merged into one \mbox {decision} cell}{table.12}{}}
