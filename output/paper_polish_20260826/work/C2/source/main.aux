\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {CoMem write--retrieve--read path.} Each 512-token document chunk is written through layers $[0,j)$ and stored as a per-token layer-$j$ activation with its text-index entry. BM25 selects fixed top-$k$ chunks; their activations and the query activation form a freshly positioned pack read by layers $[j,L)$ with full cross-pack attention. The external store grows as $O(\text  {context})$; the fixed-$k$ read pack does not (its measured read-time peak stays approximately flat through 128k but is not constant).}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:architecture}{{1}{2}{\textbf {CoMem write--retrieve--read path.} Each 512-token document chunk is written through layers $[0,j)$ and stored as a per-token layer-$j$ activation with its text-index entry. BM25 selects fixed top-$k$ chunks; their activations and the query activation form a freshly positioned pack read by layers $[j,L)$ with full cross-pack attention. The external store grows as $O(\text {context})$; the fixed-$k$ read pack does not (its measured read-time peak stays approximately flat through 128k but is not constant)}{figure.1}{}}
