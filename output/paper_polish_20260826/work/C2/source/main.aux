\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {At-cap and answer-anchored checks preserve direction but not a point magnitude.} The answer-anchored reader scans forward at most 120 characters from the last \emph  {answer} cue with no fallback; the exact implementation of \texttt  {anchored\_label} (\texttt  {split\_choices\_echo} and \texttt  {anchored\_label} both) and their pinned hashes are consolidated in the protocol matrix (Appendix Table~\ref {tab:protocol-matrix}). These sensitivity checks retain the direction of the primary result but do not establish readout invariance or a clean effect magnitude.}}{22}{table.10}\protected@file@percent }
\newlabel{tab:invariance-diagnostics}{{10}{22}{\textbf {At-cap and answer-anchored checks preserve direction but not a point magnitude.} The answer-anchored reader scans forward at most 120 characters from the last \emph {answer} cue with no fallback; the exact implementation of \texttt {anchored\_label} (\texttt {split\_choices\_echo} and \texttt {anchored\_label} both) and their pinned hashes are consolidated in the protocol matrix (Appendix Table~\ref {tab:protocol-matrix}). These sensitivity checks retain the direction of the primary result but do not establish readout invariance or a clean effect magnitude}{table.10}{}}
