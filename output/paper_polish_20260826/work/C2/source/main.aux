\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces \textbf  {Matched RULER losses are concentrated in a few cells.} Arm $j=0$ is the full-depth re-forward and $j=12$ the cached read, $n=100$/cell. NIAH rows are strict-binary. The \texttt  {variable\_tracking} rows instead show fractional \texttt  {string\_match\_all} recall and therefore carry no per-cell integer error counts. For the pooled audit they are binarized only by \texttt  {int(recall >= 1.0)}; exact McNemar operates on these paired full-match labels and is excluded from any per-cell identity lacking integer errors. The macro partial-credit drop is 3.12\,pp; the strict-binary pooled drop is $(c-b)/n=82/1500=5.47$\,pp, i.e.\ $13$ strict-binary errors at $j{=}0$ against $95$ at $j{=}12$ over the pooled 1,500 item pairs (the \texttt  {variable\_tracking} contribution enters only through the binarized labels, which is why the listed per-cell integer columns sum to fewer errors). Because the 1,500 items are clustered in 15 (task,length) cells, the pooled McNemar $p{\approx }8.8{\times }10^{-24}$ over 84 discordances is reported only as \emph  {descriptive}. No cell-clustered inferential test is reported, so the pooled test does not carry a family-wise significance claim. Under the paper's convention $b{=}1/c{=}83$: $b$ counts $j=12$-correct/$j=0$-wrong and $c$ the reverse. Superscript M marks a matched study cell, not Figure~\ref {fig:system-tradeoff}'s separate \texttt  {niah\_single} serving-sweep sample set.}}{23}{table.11}\protected@file@percent }
\newlabel{tab:ruler-percell}{{11}{23}{\textbf {Matched RULER losses are concentrated in a few cells.} Arm $j=0$ is the full-depth re-forward and $j=12$ the cached read, $n=100$/cell. NIAH rows are strict-binary. The \texttt {variable\_tracking} rows instead show fractional \texttt {string\_match\_all} recall and therefore carry no per-cell integer error counts. For the pooled audit they are binarized only by \texttt {int(recall >= 1.0)}; exact McNemar operates on these paired full-match labels and is excluded from any per-cell identity lacking integer errors. The macro partial-credit drop is 3.12\,pp; the strict-binary pooled drop is $(c-b)/n=82/1500=5.47$\,pp, i.e.\ $13$ strict-binary errors at $j{=}0$ against $95$ at $j{=}12$ over the pooled 1,500 item pairs (the \texttt {variable\_tracking} contribution enters only through the binarized labels, which is why the listed per-cell integer columns sum to fewer errors). Because the 1,500 items are clustered in 15 (task,length) cells, the pooled McNemar $p{\approx }8.8{\times }10^{-24}$ over 84 discordances is reported only as \emph {descriptive}. No cell-clustered inferential test is reported, so the pooled test does not carry a family-wise significance claim. Under the paper's convention $b{=}1/c{=}83$: $b$ counts $j=12$-correct/$j=0$-wrong and $c$ the reverse. Superscript M marks a matched study cell, not Figure~\ref {fig:system-tradeoff}'s separate \texttt {niah\_single} serving-sweep sample set}{table.11}{}}
