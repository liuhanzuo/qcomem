\@writefile{lot}{\contentsline {table}{\numberline {16}{\ignorespaces \textbf  {95\% interval constructions for the pinned decision rows of Tables~\ref {tab:readdepth-main} and~\ref {tab:readdepth-decisive}.} All three constructions exclude zero at both roots. The first two use the paired discordance; the third discards it and is therefore the assumption-free bound quoted in Table~\ref {tab:readdepth-main}. The corresponding McNemar odds ratios are $14.5$ (mnt160) and $9.0$ (mnt512). Applying the pairing-free construction to the stripped mnt512 row gives $[+10.2,+34.8]$\,pp, again excluding zero.}}{28}{table.16}\protected@file@percent }
\newlabel{tab:paired-cis}{{16}{28}{\textbf {95\% interval constructions for the pinned decision rows of Tables~\ref {tab:readdepth-main} and~\ref {tab:readdepth-decisive}.} All three constructions exclude zero at both roots. The first two use the paired discordance; the third discards it and is therefore the assumption-free bound quoted in Table~\ref {tab:readdepth-main}. The corresponding McNemar odds ratios are $14.5$ (mnt160) and $9.0$ (mnt512). Applying the pairing-free construction to the stripped mnt512 row gives $[+10.2,+34.8]$\,pp, again excluding zero}{table.16}{}}
