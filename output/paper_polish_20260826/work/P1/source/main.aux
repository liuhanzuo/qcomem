\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Schematic of the AUDIT-GATE decision path; the figure carries no quantitative content. Solid arrows are the operability chain, dashed arrows are terminating verdicts. Every terminal verdict, PASS included, is emitted together with a re-runnable certificate, and POSTPONE carries the minimal refill that would make the endpoint decidable. Symbols match Section~\ref {sec:framework}; the observer-round parameter of Section~\ref {sec:binding} ($K=2$ by default) applies to consumption verdicts rather than to the chain drawn here.}}{17}{figure.4}\protected@file@percent }
\newlabel{fig:pipeline}{{4}{17}{Schematic of the AUDIT-GATE decision path; the figure carries no quantitative content. Solid arrows are the operability chain, dashed arrows are terminating verdicts. Every terminal verdict, PASS included, is emitted together with a re-runnable certificate, and POSTPONE carries the minimal refill that would make the endpoint decidable. Symbols match Section~\ref {sec:framework}; the observer-round parameter of Section~\ref {sec:binding} ($K=2$ by default) applies to consumption verdicts rather than to the chain drawn here}{figure.4}{}}
