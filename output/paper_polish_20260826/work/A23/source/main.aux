\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces R2 residual-covariance sensitivity sweep on the frozen events stream ($61$ points; paired decode-cluster bootstrap, $B=2000$, seed $20260823$). $\rho $ denotes the disattenuated correlation and $m$ the multiplier on $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {cov}$}\mathaccent "0362{\mathrm  {cov}}_u$. \textbf  {Takeaway:} the point estimate crosses $\rho =1$ near $m\approx 0.905$, the CI upper excludes $\rho =1$ from $m\approx 0.94$, and $\Pr (\rho <1)\ge 0.99$ from $m\approx 0.945$; the result is an analysis-level sensitivity statement over the frozen asset, not a causal one.}}{13}{table.15}\protected@file@percent }
\newlabel{tab:r2sweep}{{15}{13}{R2 residual-covariance sensitivity sweep on the frozen events stream ($61$ points; paired decode-cluster bootstrap, $B=2000$, seed $20260823$). $\rho $ denotes the disattenuated correlation and $m$ the multiplier on $\widehat {\mathrm {cov}}_u$. \textbf {Takeaway:} the point estimate crosses $\rho =1$ near $m\approx 0.905$, the CI upper excludes $\rho =1$ from $m\approx 0.94$, and $\Pr (\rho <1)\ge 0.99$ from $m\approx 0.945$; the result is an analysis-level sensitivity statement over the frozen asset, not a causal one}{table.15}{}}
