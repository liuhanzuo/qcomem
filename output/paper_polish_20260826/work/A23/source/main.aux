\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Decision stability of the R3 risk anchors under label permutation ($1000$ label permutations, inner $B=1000$ paired bootstrap). Achieved per-anchor false-positive rates are $0/1000$ at every coverage, whose exact one-sided Clopper--Pearson upper bound is $\approx 0.003$. The permutation procedure tests a label-independence null, which is not the same as an equal-performance null hypothesis; we therefore report the outcome as \emph  {decision stability under this permutation procedure}, not as calibration of the detection test against the equal-performance alternative. The null-calibrated central band does not create a \texttt  {PL}$\rightarrow $\texttt  {RES} flip. \textbf  {Takeaway:} all three R3 decisions are unchanged by this permutation stress test.}}{6}{table.7}\protected@file@percent }
\newlabel{tab:nullcal}{{7}{6}{Decision stability of the R3 risk anchors under label permutation ($1000$ label permutations, inner $B=1000$ paired bootstrap). Achieved per-anchor false-positive rates are $0/1000$ at every coverage, whose exact one-sided Clopper--Pearson upper bound is $\approx 0.003$. The permutation procedure tests a label-independence null, which is not the same as an equal-performance null hypothesis; we therefore report the outcome as \emph {decision stability under this permutation procedure}, not as calibration of the detection test against the equal-performance alternative. The null-calibrated central band does not create a \texttt {PL}$\rightarrow $\texttt {RES} flip. \textbf {Takeaway:} all three R3 decisions are unchanged by this permutation stress test}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Equivalence and next-bed design at the R3 decision anchor. E0 is the practical bound $\delta ^*=1$ pp; it was fixed after the original effect estimates were observed, before the TOST recomputation, and is retained as the target for subsequent prospective replication. \textbf  {Takeaway:} lower-coverage absence is not established; the next bed needs roughly two to three times as many decodes.}}{6}{table.8}\protected@file@percent }
\newlabel{tab:powerplan}{{8}{6}{Equivalence and next-bed design at the R3 decision anchor. E0 is the practical bound $\delta ^*=1$ pp; it was fixed after the original effect estimates were observed, before the TOST recomputation, and is retained as the target for subsequent prospective replication. \textbf {Takeaway:} lower-coverage absence is not established; the next bed needs roughly two to three times as many decodes}{table.8}{}}
