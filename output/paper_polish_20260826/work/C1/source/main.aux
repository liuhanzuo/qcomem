\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces \textbf  {Mandatory achieved-precision disclosure (with one true power reference) for small-benchmark null results.} What is reported per cell is the paired-bootstrap CI95 half-width --- \emph  {achieved precision}, not classical power: only the MMLU row satisfies the standard definition (the probability that the reference cell's interval would exclude zero given its observed effect, obtained from plug-in simulation), while the remaining rows say whether their achieved half-width would resolve the reference effect. Numbers are the paired-bootstrap half-widths recorded per cell in the five-benchmark letter/content null records (evidence \textsf  {E-F}; see the reproducibility statement for the artifact path).}}{19}{table.11}\protected@file@percent }
\newlabel{tab:power}{{11}{19}{\textbf {Mandatory achieved-precision disclosure (with one true power reference) for small-benchmark null results.} What is reported per cell is the paired-bootstrap CI95 half-width --- \emph {achieved precision}, not classical power: only the MMLU row satisfies the standard definition (the probability that the reference cell's interval would exclude zero given its observed effect, obtained from plug-in simulation), while the remaining rows say whether their achieved half-width would resolve the reference effect. Numbers are the paired-bootstrap half-widths recorded per cell in the five-benchmark letter/content null records (evidence \textsf {E-F}; see the reproducibility statement for the artifact path)}{table.11}{}}
