\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The two interval estimates this note cites, each with its own resampling population. \textbf  {Left:} the C9 macro RULER gap, cell-level $95\%$ percentile bootstrap $[1.69,4.68]$\,pp (15 cells, seed 123, $n_{\mathrm  {boot}}{=}20000$). \textbf  {Right:} the \emph  {dispersion} of the C13 $G{=}512$ @128k per-query margin, paired bootstrap $[0.026,0.088]$\,s (15 units). The right panel is a dispersion measure; the citable point margin is the recomputable aggregate figure $0.0404$\,s/q (Table~\ref {tab:frozen} C13). Neither interval includes zero; the axes differ because the quantities differ.}}{13}{figure.3}\protected@file@percent }
\newlabel{fig:ci}{{3}{13}{The two interval estimates this note cites, each with its own resampling population. \textbf {Left:} the C9 macro RULER gap, cell-level $95\%$ percentile bootstrap $[1.69,4.68]$\,pp (15 cells, seed 123, $n_{\mathrm {boot}}{=}20000$). \textbf {Right:} the \emph {dispersion} of the C13 $G{=}512$ @128k per-query margin, paired bootstrap $[0.026,0.088]$\,s (15 units). The right panel is a dispersion measure; the citable point margin is the recomputable aggregate figure $0.0404$\,s/q (Table~\ref {tab:frozen} C13). Neither interval includes zero; the axes differ because the quantities differ}{figure.3}{}}
