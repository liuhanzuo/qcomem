\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces \textbf  {Masked-entropy orientation, support, and calibration.} Raw AUROC labels whether current argmax differs from the final token; CIs use trajectory bootstrap ($B=2{,}000$, seed 0). Calibration uses 400 seed-0 permutations and is $\mathrm  {real}/\mathrm  {null95}$, where $\mathrm  {null95}$ is the permutation-null 95th percentile; it is not an AUROC. NR denotes a field absent from the frozen local artifact.}}{8}{table.10}\protected@file@percent }
\newlabel{tab:crossbed}{{10}{8}{\textbf {Masked-entropy orientation, support, and calibration.} Raw AUROC labels whether current argmax differs from the final token; CIs use trajectory bootstrap ($B=2{,}000$, seed 0). Calibration uses 400 seed-0 permutations and is $\mathrm {real}/\mathrm {null95}$, where $\mathrm {null95}$ is the permutation-null 95th percentile; it is not an AUROC. NR denotes a field absent from the frozen local artifact}{table.10}{}}
