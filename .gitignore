.DS_Store
.venv/
__pycache__/
*.py[cod]
results/*.jsonl
results/*.md
results/*.json
results/raw/*
results/*_store/
!results/raw/.gitkeep

# ---- added 2026-09-03 for the qcomem transfer push ----
# GitHub rejects any single file over 100 MB and the working tree is 79 GB, so
# everything excluded below is either unreachable by that limit or not needed to
# continue the experiments on another machine.  Nothing here is source, state,
# manuscript, or archived per-item measurement.

# 53 GB of blind-review snapshots: each round stores two full copies of the PDF.
# The reviews themselves (raw/*.json, reviews/*.json, meta_review.json,
# panel_aggregate.json) are NOT excluded and remain in the repo.
paper_autonomous_multifork_iteration/review/*/submission/

# transport payloads, wheels and build tarballs
tmp/
paper_autonomous_multifork_iteration/tmp/
*.whl
*.tgz
*.tar.gz

# unrelated projects living in this working tree
CampusOS/
01_p5/
third_party/

# large binary artifacts
*.pt
*.a
*.metallib
results/**/artifacts/
paper_autonomous_multifork_iteration/build/
paper_autonomous_multifork_iteration/supplement_anonymous/

# local scratch
.forkaudit-temp/
.v31-rebuild.*/

# 19.5 GB of LaTeX build attempts and 1.3 GB per early review round: these are
# rebuildable artifacts and duplicated PDFs, not source or measurement.
paper_autonomous_multifork_iteration/review/build_attempts/
paper_autonomous_multifork_iteration/review/reviewer_safe/
paper_autonomous_multifork_iteration/review/reviewer_blind/
paper_autonomous_multifork_iteration/review/round_*/pdf_only/
paper_autonomous_multifork_iteration/review/round_*/pdf_plus_repository/
paper_autonomous_multifork_iteration/review/round_*/*.pdf
paper_autonomous_multifork_iteration/review/round_*/manuscript/
paper_autonomous_multifork_iteration/review/round_*/.submission-staging/
